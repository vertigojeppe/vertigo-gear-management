# Copy to .env and adjust. Never commit .env.

# --- Database -------------------------------------------------------------
# Local dev: `docker compose up -d db` provides this.
DATABASE_URL="postgresql://vertigo:vertigo@localhost:5432/vertigo_gear"
# Used by docker-compose.yml for the db service (defaults shown).
POSTGRES_USER=vertigo
POSTGRES_PASSWORD=vertigo
POSTGRES_DB=vertigo_gear
POSTGRES_PORT=5432

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
# Public URL of the app: encoded in QR labels and used for links in emails
# and calendar feeds. Set it to the real address before printing labels.
# While it is localhost, QR codes use the address the page was opened from,
# with localhost swapped for this machine's LAN address so phones can follow them.
APP_URL="http://localhost:3000"
# Production (docker compose --profile prod): the DNS name Caddy serves with
# automatic HTTPS. APP_URL must then be https://<APP_DOMAIN>.
# APP_DOMAIN=gear.vertigo.dk
# The app listens on 127.0.0.1 only; this opens it on every interface.
# APP_BIND=0.0.0.0
# Office server behind a Cloudflare Tunnel (docker compose --profile tunnel):
# the token from Zero Trust › Networks › Tunnels; Cloudflare terminates HTTPS,
# no APP_DOMAIN or Caddy needed. APP_URL=https://<the public hostname>.
# CLOUDFLARE_TUNNEL_TOKEN=

# Roles that must use two-factor sign-in (authenticator app), comma-separated.
# Unset = admin. "none" turns the requirement off (CI, browser tests); anyone
# can still turn it on for themselves under Settings › Your account.
# TWO_FACTOR_REQUIRED_ROLES=admin

# Gear on projects: the "Reserved gear", "Rent in" and quote sections. Hidden
# unless this is "on"; nothing is deleted while it is off (src/lib/features.ts).
# PROJECT_GEAR=on

# Spec lookup on model pages: paste a manufacturer's product page or
# datasheet and the specs are read out for review. A free key from
# https://aistudio.google.com (Get API key). Without it the lookup is off.
# GEMINI_API_KEY=
# Optional: another Gemini model (default gemini-3.8-flash).
# SPEC_LOOKUP_MODEL=

# --- Seed -----------------------------------------------------------------
# Password given to the demo users created by `npm run db:seed`.
SEED_PASSWORD="vertigo123"

# --- Files ----------------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=500
# S3-compatible storage (Cloudflare R2, MinIO) when STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# --- Google Calendar push (optional, one-way app → Google) --------------------
# Path to the service account key file, or the JSON itself. See README.
# GOOGLE_SERVICE_ACCOUNT_JSON=./google-service-account.json
# Calendar ids (Settings › Integrate calendar › Calendar ID) shared with the
# service account email with "Make changes to events".
# GOOGLE_CALENDAR_ID_PROJECTS=abc123@group.calendar.google.com
# GOOGLE_CALENDAR_ID_RENTALS=def456@group.calendar.google.com

# --- Background work -----------------------------------------------------------
# The app delivers webhooks and calendar pushes from an in-process worker.
# On serverless hosts, call POST /api/cron/outbox every minute instead:
# CRON_SECRET=
# Set to 1 to disable the in-process worker (tests, one-off scripts).
# OUTBOX_DISABLED=

# --- Backups (scripts/backup.sh) ----------------------------------------------
# Local archives (database dump + uploads) and how long to keep them.
# BACKUP_DIR=backups
# BACKUP_KEEP_DAYS=14
# Off-site copy with rclone (`rclone config` once): an S3/R2/Backblaze remote and bucket.
# BACKUP_REMOTE=r2:vertigo-gear-backups

# --- Email (optional, enables magic links and password reset) --------------
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="Vertigo Gear <gear@vertigo.dk>"
