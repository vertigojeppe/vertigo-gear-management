# Copy to .env and adjust. Never commit .env.

# --- Database -------------------------------------------------------------
# Local dev: `docker compose up -d db` provides this.
DATABASE_URL="postgresql://vertigo:vertigo@localhost:5432/vertigo_gear"
# Used by docker-compose.yml for the db service (defaults shown).
POSTGRES_USER=vertigo
POSTGRES_PASSWORD=vertigo
POSTGRES_DB=vertigo_gear
POSTGRES_PORT=5432

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
# Public URL of the app: encoded in QR labels and used for links in emails
# and calendar feeds. Set it to the real address before printing labels.
# While it is localhost, QR codes use the address the page was opened from.
APP_URL="http://localhost:3000"

# --- Seed -----------------------------------------------------------------
# Password given to the demo users created by `npm run db:seed`.
SEED_PASSWORD="vertigo123"

# --- Files ----------------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=500
# S3-compatible storage (Cloudflare R2, MinIO) when STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# --- Google Calendar push (optional) ----------------------------------------
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_CALENDAR_ID_PROJECTS=
# GOOGLE_CALENDAR_ID_RENTALS=

# --- Email (optional, enables magic links and password reset) --------------
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="Vertigo Gear <gear@vertigo.dk>"
