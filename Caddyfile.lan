# Reverse proxy for an office server without a public DNS name: Caddy signs the
# certificate with its own local CA instead of Let's Encrypt. Install that CA's
# root certificate on every phone and laptop (README › Office server on the LAN),
# otherwise browsers warn and the camera scanner stays off.
# Select it with CADDYFILE=./Caddyfile.lan in .env.
{$APP_DOMAIN} {
	tls internal
	encode zstd gzip
	request_body {
		max_size 600MB
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy app:3000
}
