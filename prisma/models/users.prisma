// users module

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  /// One of the role keys in config/app.config.ts (admin | member | viewer).
  role         String   @default("member")
  phone        String?
  /// Google account email used when adding the user as a calendar attendee.
  googleEmail  String?
  active       Boolean  @default(true)
  /// UI language ("en" | "da", appConfig.locales); null = the browser's language.
  locale       String?
  /// Two-factor sign-in (authenticator app). The TOTP secret is encrypted with a key derived
  /// from AUTH_SECRET (src/lib/auth/two-factor.ts); null = 2FA off.
  totpSecret    String?
  totpEnabledAt DateTime?
  /// Last accepted 30-second step, so every code works only once.
  totpLastStep  Int?
  /// sha256 hashes of the recovery codes not used yet.
  recoveryCodes Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  apiTokens   ApiToken[]
  crew        ProjectCrew[]
  feedTokens  CalendarFeedToken[]
  statusLogs  StatusLog[]
  activity    ActivityLog[]
  files       File[]
  packingChecks PackingCheck[]
  shareLinks  ShareLink[]
  /// "Mikkel has 2": locations of type person pointing at this user.
  locations   Location[]
  scheduleEntries ScheduleEntry[]
  planTasks   PlanTask[]
  markups     Markup[]
  uploadSessions UploadSession[]
  wishItems   WishItem[]
  purchases   Purchase[]
  stockMovements StockMovement[]
  calendarEntries CalendarEntryPerson[]
  createdCalendarEntries CalendarEntry[] @relation("CalendarEntryCreatedBy")
  apps        App[]        @relation("AppCreatedBy")
  appVersions AppVersion[] @relation("AppVersionUploadedBy")

  @@index([role])
}

/// Per-user bearer tokens for the REST API. Only the hash is stored.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  /// First characters of the token, shown in the UI to identify it.
  prefix     String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// Who changed what. Written by every mutating service.
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  entityType String
  entityId   String
  /// "created" | "updated" | "deleted" | "status_changed" | ...
  action     String
  /// Human-readable one-liner.
  summary    String
  /// Optional structured details (changed fields, before/after).
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

/// Named counters (asset tag sequence etc.).
model Counter {
  key   String @id
  value Int    @default(0)
}
