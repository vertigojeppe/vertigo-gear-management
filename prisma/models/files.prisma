// files module
// Phase 1: single-version files served through the storage adapter.
// Phase 4 adds FileVersion, FileLink and Markup.

model File {
  id          String   @id @default(cuid())
  name        String
  mimeType    String
  size        Int
  /// Key inside the storage driver (local path or S3 object key).
  storageKey  String
  /// Key of the generated thumbnail, if any (images and, later, PDFs).
  thumbKey    String?
  uploaderId  String?
  uploader    User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  attachments       Attachment[]
  modelDefaultPhoto Model[]      @relation("ModelDefaultPhoto")
  documentVersions  PlanDocumentVersion[]
  documentPreviews  PlanDocument[] @relation("DocumentPreview")
  appVersions       AppVersion[]
}

/// Links a file to any entity (item, model, later project/plan).
model Attachment {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  fileId     String
  file       File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  /// "photo" | "invoice" | "manual" | "other"
  kind       String   @default("other")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
