// todos module

/// A personal to-do note. Only its owner sees it (dashboard, "My to-dos"),
/// so nothing about it goes in the shared activity log.
model Todo {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  /// Free text the list groups by; null = no heading.
  category  String?
  /// Order within the owner's list; ↑ / ↓ renumber one category group.
  position  Int       @default(0)
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
