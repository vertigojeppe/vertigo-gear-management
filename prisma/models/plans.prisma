// plans module — production plans (Phase 4). Documents, drawings and
// markup come in Phase 4b and will hang off ScheduleEntry / PlanTask.

/// One plan per project: schedule, tasks, logistics. Crew and contacts
/// live on the project itself and are shown inside the plan.
model ProductionPlan {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  notes     String?
  schedule  ScheduleEntry[]
  tasks     PlanTask[]
  logistics LogisticsEntry[]
  documents PlanDocument[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// "Rig truss, Tuesday 10:00–16:00, stage left, Mikkel".
model ScheduleEntry {
  id            String         @id @default(cuid())
  planId        String
  plan          ProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Copenhagen wall-clock stored as UTC.
  startsAt      DateTime
  durationMin   Int?
  title         String
  location      String?
  responsibleId String?
  responsible   User?          @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  notes         String?
  sortOrder     Int            @default(0)
  documents     PlanDocument[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([planId, startsAt])
  @@index([responsibleId])
}

/// To-do with assignee, due date and done state, grouped by phase.
model PlanTask {
  id         String         @id @default(cuid())
  planId     String
  plan       ProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Key from PLAN_PHASES in config/app.config.ts.
  phase      String         @default("pre_production")
  title      String
  assigneeId String?
  assignee   User?          @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate    DateTime?      @db.Date
  done       Boolean        @default(false)
  doneAt     DateTime?
  notes      String?
  sortOrder  Int            @default(0)
  documents  PlanDocument[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([planId, phase])
  @@index([assigneeId, done])
}

/// Vehicles, parking, loading dock, hotel, travel.
model LogisticsEntry {
  id        String         @id @default(cuid())
  planId    String
  plan      ProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Key from LOGISTICS_KINDS in config/app.config.ts.
  kind      String         @default("other")
  title     String
  details   String?
  at        DateTime?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([planId])
}

/// Reusable plan: entries relative to an anchor day (load-in = day 0).
model PlanTemplate {
  id          String              @id @default(cuid())
  name        String
  description String?
  entries     PlanTemplateEntry[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model PlanTemplateEntry {
  id            String       @id @default(cuid())
  templateId    String
  template      PlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// "schedule" | "task" | "logistics"
  kind          String
  /// Days relative to the anchor date (-1 = the day before load-in).
  dayOffset     Int          @default(0)
  /// "HH:MM" for schedule and logistics entries.
  time          String?
  durationMin   Int?
  title         String
  location      String?
  /// Tasks: key from PLAN_PHASES.
  phase         String?
  /// Logistics: key from LOGISTICS_KINDS.
  logisticsKind String?
  notes         String?
  sortOrder     Int          @default(0)

  @@index([templateId])
}

/// A document on a plan (rider, stage plot, CAD, 3D model, risk assessment).
/// Uploading a file with the same name adds a version; old versions stay.
model PlanDocument {
  id              String         @id @default(cuid())
  planId          String
  plan            ProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Logical name, normally the file name.
  name            String
  /// Pinned to a schedule entry or a task ("the load-in drawing on Rig truss").
  scheduleEntryId String?
  scheduleEntry   ScheduleEntry? @relation(fields: [scheduleEntryId], references: [id], onDelete: SetNull)
  taskId          String?
  task            PlanTask?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// User-uploaded preview image for formats without an inline viewer (SKP, DWG, ...).
  previewFileId   String?
  previewFile     File?          @relation("DocumentPreview", fields: [previewFileId], references: [id], onDelete: SetNull)
  versions        PlanDocumentVersion[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([planId, name])
  @@index([scheduleEntryId])
  @@index([taskId])
}

model PlanDocumentVersion {
  id         String       @id @default(cuid())
  documentId String
  document   PlanDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    Int
  fileId     String
  file       File         @relation("DocumentVersionFile", fields: [fileId], references: [id], onDelete: Restrict)
  /// PDF made from a Word file on upload (LibreOffice); viewed, marked up and
  /// put in the plan PDF instead of the original, which stays downloadable.
  pdfFileId  String?
  pdfFile    File?        @relation("DocumentVersionPdf", fields: [pdfFileId], references: [id], onDelete: SetNull)
  note       String?
  markups    Markup[]
  createdAt  DateTime     @default(now())

  @@unique([documentId, version])
  @@index([pdfFileId])
}

/// Drawings on top of an image or a PDF page: a separate layer, never baked
/// into the file. One row per version and page; shapes carry their author.
model Markup {
  id          String              @id @default(cuid())
  versionId   String
  version     PlanDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  page        Int                 @default(1)
  /// [{ id, type: "path" | "arrow" | "rect" | "text", points: [x,y,...] (0..1), text?, color, authorId, authorName, createdAt }]
  shapes      Json                @default("[]")
  updatedById String?
  updatedBy   User?               @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime            @updatedAt

  @@unique([versionId, page])
}

/// A chunked upload in progress; the bytes sit in storage under partKey
/// until the client completes it and a File row is created.
model UploadSession {
  id         String   @id @default(cuid())
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  name       String
  mimeType   String
  size       Int
  received   Int      @default(0)
  chunkSize  Int
  partKey    String
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}
