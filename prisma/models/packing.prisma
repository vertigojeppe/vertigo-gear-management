// packing module

/// A packing list belongs to a project. Lines are models + quantities;
/// specific units are recorded in PackingCheck rows as they are packed.
model PackingList {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  /// "category" | "case"
  groupBy      String        @default("category")
  /// "draft" | "checked_out" | "checked_in"
  status       String        @default("draft")
  checkedOutAt DateTime?
  checkedInAt  DateTime?
  /// Part ids whose spare suggestion was waved off on this list ("not this time").
  dismissedSpares Json        @default("[]")
  notes        String?
  lines        PackingLine[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([projectId])
}

model PackingLine {
  id         String         @id @default(cuid())
  listId     String
  list       PackingList    @relation(fields: [listId], references: [id], onDelete: Cascade)
  modelId    String
  model      Model          @relation(fields: [modelId], references: [id], onDelete: Restrict)
  quantity   Int            @default(1)
  /// Pre-assigned unit (a kit, or a chosen serialized unit).
  itemId     String?
  item       Item?          @relation("PackingLineItem", fields: [itemId], references: [id], onDelete: SetNull)
  /// The kit/case this line travels in (grouping for "by case").
  caseItemId String?
  caseItem   Item?          @relation("PackingLineCase", fields: [caseItemId], references: [id], onDelete: SetNull)
  note       String?
  sortOrder  Int            @default(0)
  checks     PackingCheck[]
  createdAt  DateTime       @default(now())

  @@index([listId])
  @@index([modelId])
  @@index([itemId])
  @@index([caseItemId])
}

/// One row per packed unit (serialized) or per packed quantity (bulk),
/// per phase. Check-in rows reference the out row they close.
model PackingCheck {
  id           String       @id @default(cuid())
  lineId       String
  line         PackingLine  @relation(fields: [lineId], references: [id], onDelete: Cascade)
  /// "out" | "in"
  phase        String
  /// The unit that went out / came back. For bulk: the travel bin.
  itemId       String?
  item         Item?        @relation("PackingCheckItem", fields: [itemId], references: [id], onDelete: SetNull)
  /// Bulk only: the warehouse bin the quantity was taken from.
  sourceItemId String?
  /// In-checks: the out-check they answer, so a return can be undone.
  outCheckId   String?
  outCheck     PackingCheck?  @relation("CheckInOf", fields: [outCheckId], references: [id], onDelete: SetNull)
  checkIns     PackingCheck[] @relation("CheckInOf")
  /// In-checks: the item the return ended up on (the unit, the source bin after
  /// a merge, or the split-off damaged/missing bin), so undo knows what to reverse.
  resultItemId String?
  resultItem   Item?          @relation("PackingCheckResult", fields: [resultItemId], references: [id], onDelete: SetNull)
  quantity     Int          @default(1)
  /// "ok" | "missing" | "damaged"
  outcome      String       @default("ok")
  note         String?
  checkedById  String?
  checkedBy    User?        @relation(fields: [checkedById], references: [id], onDelete: SetNull)
  checkedAt    DateTime     @default(now())
  /// "used" in-checks of a consumable: the ledger row the use wrote, so undo can remove it.
  stockMovement StockMovement?

  @@index([lineId, phase])
  @@index([itemId])
  @@index([outCheckId])
  @@index([resultItemId])
}

model PackingTemplate {
  id          String                @id @default(cuid())
  name        String
  description String?
  lines       PackingTemplateLine[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model PackingTemplateLine {
  id         String          @id @default(cuid())
  templateId String
  template   PackingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  modelId    String
  model      Model           @relation(fields: [modelId], references: [id], onDelete: Restrict)
  quantity   Int             @default(1)
  note       String?
  sortOrder  Int             @default(0)

  @@index([templateId])
  @@index([modelId])
}

/// Read-only share links for packing lists (and plans in Phase 4).
model ShareLink {
  id          String    @id @default(cuid())
  /// "packing_list" | "plan"
  targetType  String
  targetId    String
  token       String    @unique
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([targetType, targetId])
}
